# Settings for compose.yaml. Copy to .env, fill in the values and run "chmod 600 .env".
# Never commit .env. See docs/DOCKER.md.

# The public HTTPS address of the tunnel, without a path.
MBX_PUBLIC_URL=https://mbx.example.org

# Built-in OAuth: you type this on the approval page. Make it with:
# openssl rand -base64 32
MBX_MCP_OWNER_SECRET=

# Cloudflare Access instead of the built-in OAuth: uncomment these four lines and leave
# MBX_MCP_OWNER_SECRET empty.
# COMPOSE_FILE=compose.yaml:compose.access.yaml
# MBX_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# MBX_ACCESS_AUD=
# MBX_ACCESS_EMAIL=you@example.org

# Offer changes as well as reads. Limit them with [mcp] allowed_writes in config.toml.
MBX_ALLOW_WRITES=false

# Starts the cloudflared container. Remove this line if cloudflared runs on the host.
COMPOSE_PROFILES=tunnel
# The tunnel token from the Cloudflare dashboard (Networking > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Leave both empty to use the session from "docker compose run --rm mbx login".
# With both values, the server can sign in again when the session expires.
MBX_USERNAME=
MBX_PASSWORD=

# The owner of the data directory on the host: the output of "id -u" and "id -g".
MBX_UID=1000
MBX_GID=1000

# Optional settings.
# MBX_DATA_DIR=./mbx-data
# MBX_HOST_PORT=8808
# TZ=Europe/Berlin
