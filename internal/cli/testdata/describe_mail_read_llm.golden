{"name":"mail.read","summary":"Read one message's body text and attachment list; changes state only with --mark-seen, which marks it seen","usage":"mbx mail read --folder <string> --id <string>","effect":"read","idempotent":true,"args":{"body-format":{"type":"string","required":false},"folder":{"type":"string","required":true},"id":{"type":"string","required":true},"mark-seen":{"type":"bool","required":false,"effect":"write"},"max-body-bytes":{"type":"int","required":false}},"output":{"type":"object","fields":["id","folder","subject","from","to","cc","bcc","sent_date","received_date","size","seen","flagged","body_format","body","body_bytes","body_truncated","attachments","nested_messages"]}}
